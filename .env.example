# Copy this file to `.env` (in the project root) and fill in your values.
# `.env` is git-ignored. Do not commit real secrets.
#
# This file is only needed when you run the project LOCALLY in VS Code.
# On Replit, the platform injects these for you automatically.

# --- AI Symptom Checker (Anthropic) ---
# Get a key at https://console.anthropic.com/settings/keys
# Without this, the AI Symptom Checker page will return 503; the rest of the
# app (records, education, QR, voice, etc.) keeps working offline.
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional port overrides (defaults shown) ---
# API_PORT=3001
# WEB_PORT=5173
